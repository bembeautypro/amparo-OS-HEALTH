# =============================================================
# Amparo — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — ele está no .gitignore.
# =============================================================

# ---------------------------
# Supabase (obrigatório)
# Encontre em: Supabase Dashboard → Project Settings → API
# ---------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-anon-key-publica>

# ---------------------------
# IA / OCR (P1 — opcional no MVP)
# ---------------------------
# OPENAI_API_KEY=sk-...

# ---------------------------
# WhatsApp (P1 — lembretes)
# ---------------------------
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------
# Apenas para Edge Functions (backend — nunca expor no frontend)
# ---------------------------
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key-secreta>
